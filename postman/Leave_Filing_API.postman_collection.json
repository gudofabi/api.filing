    {
      "name": "Leave Requests - List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/leave-requests?employee_id={{employee_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "leave-requests"
          ],
          "query": [
            {
              "key": "employee_id",
              "value": "{{employee_id}}",
              "description": "Optional. Remove this query param to list all leave requests."
            }
          ]
        },
        "description": "Lists leave requests. Supports optional filter by employee_id."
      },
      "response": []
    },
    {
      "name": "Create Leave Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employee_id\": {{employee_id}},\n  \"start_date\": \"2026-03-03\",\n  \"end_date\": \"2026-03-05\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/leave-requests",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "leave-requests"
          ]
        },
        "description": "Files a leave request with overlap validation and holiday-aware deductible day calculation."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has leave data\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property(\"data\");",
              "  pm.expect(json.data).to.have.property(\"id\");",
              "  pm.expect(json.data).to.have.property(\"employee_id\");",
              "  pm.expect(json.data).to.have.property(\"start_date\");",
              "  pm.expect(json.data).to.have.property(\"end_date\");",
              "  pm.expect(json.data).to.have.property(\"deductible_days\");",
              "});"
            ]
          }
        }
      ]
    },
